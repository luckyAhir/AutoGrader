{
  "problem": "add_two_integers",
  "statement_file": "problem.md",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "compile_flags": "-O2 -Wall -Wextra -std=c11",
  "reference_solution": "reference.c",
  "sample": { "input": "7 5\n", "output": "12\n" },
  "compare": { "mode": "lines" },
  "input_spec": {
    "variables": [
      { "name": "a", "type": "int", "min": -2147483648, "max": 2147483647 },
      { "name": "b", "type": "int", "min": -2147483648, "max": 2147483647 }
    ],
    "layout": [["a", "b"]]
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.20,
      "params": { "testset_dir": "tests/" }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.10,
      "params": { "flags": "-Wall -Wextra -Werror -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": { "max_cyclomatic": 8, "max_function_length": 40 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2,
                  "helper_hint": "long long add(long long lhs, long long rhs)" }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.10,
      "params": { "cases": ["negatives", "zero", "int_overflow"] }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.10,
      "params": { "required": "O(1)", "sizes": [1, 10, 100] }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.10,
      "params": { "flags": "-fsanitize=address,undefined" }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.10,
      "params": { "provider": "ollama", "model": "qwen2.5-coder:7b",
                  "temperature": 0, "seed": 42, "mode": "hybrid", "llm_weight": 0.5 }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.10,
      "params": { "corpus_dir": "../../../submissions/add_two_integers/",
                  "known_sources_dir": "known_sources/",
                  "flag_threshold": 0.85 }
    }
  ]
}
