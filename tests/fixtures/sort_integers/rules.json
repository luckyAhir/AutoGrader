{
  "problem": "sort_integers",
  "statement_file": "problem.md",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "compile_flags": "-O2 -Wall -Wextra -std=c11",
  "reference_solution": "reference.c",
  "sample": { "input": "5\n3 1 4 1 5\n", "output": "1 1 3 4 5\n" },
  "compare": { "mode": "lines" },
  "input_spec": {
    "variables": [
      { "name": "n", "type": "int", "min": 0, "max": 100000, "role": "size" },
      { "name": "values", "type": "int[]", "length": "n", "min": -2147483648, "max": 2147483647 }
    ],
    "layout": [["n"], ["values"]]
  },
  "feedback": { "max_counterexamples": 8 },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.25,
      "params": { "testset_dir": "tests/" }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.05,
      "params": { "flags": "-Wall -Wextra -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": { "max_cyclomatic": 10, "max_function_length": 40, "max_nesting": 3 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.05,
      "params": { "expect_helpers": true, "min_functions": 3 }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.15,
      "params": { "cases": ["empty", "single", "negatives", "duplicates", "sorted",
                            "reverse_sorted", "int_overflow", "whitespace", "random"] }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.15,
      "params": { "required": "O(n log n)", "sizes": [500, 1000, 2000, 4000, 8000] }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.10,
      "params": { "flags": "-fsanitize=address,undefined",
                  "inputs": ["sample", "tests", "edge_cases"],
                  "edge_categories": ["empty", "single", "int_overflow"] }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.05,
      "params": { "provider": "ollama", "model": "qwen2.5-coder:7b",
                  "temperature": 0, "seed": 42, "mode": "hybrid" }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.05,
      "params": { "corpus_dir": "../../../submissions/sort_integers/",
                  "known_sources_dir": "known_sources/",
                  "flag_threshold": 0.85 }
    },
    {
      "name": "forbidden",
      "analyzer": "forbidden_constructs",
      "weight": 0.05,
      "params": { "forbidden_calls": ["gets", "system"], "forbidden_keywords": ["goto"] }
    }
  ]
}
